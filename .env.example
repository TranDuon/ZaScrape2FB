# ---------- MongoDB (Atlas M0) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sale_room_agent

# ---------- Timezone (BAT BUOC) ----------
# Moi tinh toan ngay/gio theo gio VN, khong theo UTC cua VPS
TZ=Asia/Ho_Chi_Minh

# ---------- Zalo ----------
ZALO_SESSION_DIR=./data/zalo-session
ZALO_IMAGE_DIR=./data/images
# Chi xu ly tin nhan tu cac thread nay (group hoac 1-1). De trong = nhan tat ca.
ZALO_ALLOWED_THREAD_IDS=
# Chi xu ly tin nhan tu cac nguoi gui nay. De trong = nhan tat ca.
ZALO_ALLOWED_SENDER_IDS=
# Gom tin nhan lien tiep cung 1 nguoi gui trong cua so nay (debounce)
ZALO_BATCH_WINDOW_MS=45000
# Tran cung: batch khong bao gio mo lau hon nguong nay
ZALO_BATCH_MAX_MS=300000
# Tran tin nhan MOI NGAY MOI NHOM Zalo. Loc ngay o khau thu, TRUOC khi ton dong Gemini nao:
# 3 nhom doi ve 50-100 phong/ngay trong khi ca ngay chi dang duoc ~15 bai.
MAX_LISTINGS_PER_THREAD_PER_DAY=5
# Tran thu rieng tung nhom Zalo (threadId:so), de trong thi moi nhom dung tran mac dinh tren.
# Dat theo mat do tin that cua tung nhom; tong nen bang MAX_POSTS_PER_DAY / MAX_GROUPS_PER_LISTING.
LISTINGS_PER_THREAD_OVERRIDES=
ZALO_RECONNECT_MAX_ATTEMPTS=5
ZALO_RECONNECT_MAX_BACKOFF_MS=300000
# Bao tin nhan RIENG (1-1) gui toi tai khoan Zalo nay len Telegram (khach nhan hoi phong, nhat la
# nguoi la). Moi nguoi chi bao 1 lan trong COOLDOWN phut.
ZALO_DM_ALERT_ENABLED=true
ZALO_DM_ALERT_COOLDOWN_MINUTES=10

# ---------- Gemini (trich xuat du lieu bang LLM) ----------
GEMINI_API_KEY=
# Model can ho tro vision (doc anh) + structured output.
# gemini-2.5-flash da bi Google ngung cap cho tai khoan moi (loi 404).
# Thay the nhanh hon: gemini-3.5-flash
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
# So anh toi da gui vao 1 request. Dat 0 = TAT HAN viec gui anh cho Gemini.
# Anh la phan ton token nhat cua buoc trich xuat (~1.100 token/anh) trong khi thong tin
# phong gan nhu luon nam trong phan CHU. Anh van duoc tai ve va van dang du len Facebook.
MAX_IMAGES_PER_EXTRACTION=0
# Thu nho canh dai anh truoc khi gui de giam token
EXTRACTION_IMAGE_MAX_DIMENSION=1024
# Duoi nguong nay thi chuyen sang cho nguoi duyet thay vi tu dong dang
CONFIDENCE_THRESHOLD=0.7
# Chu ky quet job cua worker
WORKER_POLL_INTERVAL_MS=5000

# ---------- Gom lo loi goi Gemini (tiet kiem han ngach) ----------
# Han ngach goi mien phi dem theo SO LAN GOI moi ngay moi model, khong theo token.
# Gom N tin vao mot lan goi => cung han ngach do xu ly duoc gap N lan so tin.
# Cua so cho gom them tin truoc khi goi (ms). 0 = khong cho, goi ngay.
LLM_BATCH_WINDOW_MS=300000
# So tin toi da trong mot lan goi trich xuat. Du so la chay ngay, khong cho het cua so.
EXTRACTION_BATCH_SIZE=10
# Tran TONG so anh cua ca lo, chia deu cho cac tin trong lo.
EXTRACTION_BATCH_MAX_IMAGES=16

# ---------- Composer (soan bai dang Facebook) ----------
GEMINI_COMPOSER_MODEL=gemini-3.5-flash
POST_VARIATION_COUNT=3
# Thap hon lo trich xuat: so bai phai viet mot lan = COMPOSE_BATCH_SIZE x so group.
# Lo qua lon de bi cat cut output -> hong JSON -> ca lo phai chay lai.
COMPOSE_BATCH_SIZE=3
# Gian cach giua 2 bai, cong don ngau nhien. GAN LIEN voi MAX_POSTS_PER_DAY:
# 15 bai -> 35-65, 10 bai -> 45-105, 5 bai -> 80-160. MIN >= nhip tick scheduler.
COMPOSE_STAGGER_MIN_MINUTES=35
COMPOSE_STAGGER_MAX_MINUTES=65

# ---------- Retention ----------
# Tin chua dang duoc qua so ngay nay thi het han, huy job dang cho + cho phep don anh.
# Dat thap (2) vi phong tro mat gia rat nhanh: dang phong cua 3 ngay truoc thi phan lon da cho thue.
LISTING_MAX_AGE_DAYS=2
JOB_HISTORY_RETENTION_DAYS=7
IMAGE_RETENTION_DAYS=30
DISK_USAGE_WARN_PERCENT=85
SESSION_BACKUP_DIR=./data/session-backups
SESSION_BACKUP_KEEP=5

# ---------- Logging ----------
LOG_LEVEL=info
LOG_PRETTY=true
LOG_DIR=./logs
LOG_RETENTION_DAYS=7

# ---------- Facebook (Playwright) ----------
FB_BROWSER_PROFILE_DIR=./data/fb-browser-profile
FB_SCREENSHOT_DIR=./data/fb-screenshots
# May dev: de false de nhin tan mat agent thao tac. VPS: bat buoc true.
FB_HEADLESS=false
FB_ACTION_TIMEOUT_MS=30000
# Lich kiem tra hop thu Messenger cua tai khoan dang bai (ca "Tin nhan dang cho" cua nguoi la),
# bao khach nhan tin len Telegram. De rong = tat. Khong nen day hon 10 phut.
FB_INBOX_CHECK_CRON=*/15 6-23 * * *

# ---------- Gioi han dang bai (CO Y dat thap cho tai khoan moi) ----------
# Tai khoan Facebook moi tao gan nhu khong co diem tin cay. Chi tang dan sau
# vai tuan chay em, khong dat cao ngay tu dau.
MAX_POSTS_PER_DAY=15
# Suat BU moi ngay cho "bai ton": bai soan tu ngay truoc ma chua kip dang (may tat, vap quy tac
# cach 180 phut/nhom...). Bai ton luon duoc dang TRUOC bai moi; N bai ton dau tien moi ngay KHONG
# tinh vao MAX_POSTS_PER_DAY. Tong toi da moi ngay = MAX_POSTS_PER_DAY + so nay.
# 0 = van uu tien bai ton nhung khong mien han muc.
CARRYOVER_EXTRA_POSTS_PER_DAY=5
# Mac dinh khi them nhom moi (seed:groups add). Gia tri that nam trong tung nhom o MongoDB.
GROUP_MIN_INTERVAL_MINUTES=120
# So nhom toi da MOT tin duoc dang len. Cung voi MAX_POSTS_PER_DAY, bien nay quyet dinh
# luon so tin duoc soan moi ngay = MAX_POSTS_PER_DAY / MAX_GROUPS_PER_LISTING (15/1 = 15 tin).
# GIU <= POST_VARIATION_COUNT: vuot qua thi cac nhom bat dau dung lai nguyen van bai cua nhau,
# dung thu Facebook do tim de phat hien dang spam cheo nhom.
MAX_GROUPS_PER_LISTING=1
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=22
# Nhieu khung gio dang (gio VN), vd "07:00-08:30,11:00-13:00,18:00-22:30".
# Co gia tri thi THAY HAN cap START/END o tren; de trong thi dung cap do.
ACTIVE_WINDOWS=
ACTIVE_HOURS_JITTER_MINUTES=30
HUMAN_DELAY_MIN_MS=600
HUMAN_DELAY_MAX_MS=2500

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Lay bang: npm run telegram:chatid (sau khi da nhan tin cho bot)
TELEGRAM_CHAT_ID=

# ---------- Scheduler & Health ----------
SCHEDULER_TICK_CRON=*/20 * * * *
HEALTH_CHECK_PORT=3100
# Chi nghe localhost. Xem tu xa qua SSH tunnel:
#   ssh -L 3100:127.0.0.1:3100 user@vps
HEALTH_CHECK_BIND=127.0.0.1

# ---------- Dashboard (npm run dashboard / tu khoi dong cung Windows) ----------
# Trang quan ly: http://127.0.0.1:3200 — dashboard giu agent chay nhu tien trinh con.
DASHBOARD_PORT=3200
# Chi nghe localhost: dashboard bam duoc Dung/Duyet ma khong co dang nhap nao.
DASHBOARD_BIND=127.0.0.1
# Mo dashboard la chay agent luon. false = chi xem so lieu, bam Chay moi bat agent.
DASHBOARD_AUTOSTART_AGENT=true

