{
    "name": "sale-room-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "predev": "node scripts/ensure-utf8-console.mjs",
        "dev": "tsx watch src/index.ts",
        "prestart": "node scripts/ensure-utf8-console.mjs",
        "start": "tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "prelogin:zalo": "node scripts/ensure-utf8-console.mjs",
        "login:zalo": "tsx scripts/login-zalo.ts",
        "prelist:threads": "node scripts/ensure-utf8-console.mjs",
        "list:threads": "tsx scripts/list-zalo-threads.ts",
        "precheck:db": "node scripts/ensure-utf8-console.mjs",
        "check:db": "tsx scripts/check-db.ts",
        "precheck:listings": "node scripts/ensure-utf8-console.mjs",
        "check:listings": "tsx scripts/check-listings.ts",
        "precheck:stuck": "node scripts/ensure-utf8-console.mjs",
        "check:stuck": "tsx scripts/check-stuck.ts",
        "preinject": "node scripts/ensure-utf8-console.mjs",
        "inject": "tsx scripts/inject-listing.ts",
        "preresume": "node scripts/ensure-utf8-console.mjs",
        "resume": "tsx scripts/resume.ts",
        "reset-db": "tsx scripts/reset-db.ts",
        "precleanup:images": "node scripts/ensure-utf8-console.mjs",
        "cleanup:images": "tsx scripts/cleanup-images.ts",
        "prebackup:sessions": "node scripts/ensure-utf8-console.mjs",
        "backup:sessions": "tsx scripts/backup-sessions.ts",
        "pretest:extractor": "node scripts/ensure-utf8-console.mjs",
        "test:extractor": "tsx test/extractor.manual.ts",
        "pretest": "node scripts/ensure-utf8-console.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "preseed:groups": "node scripts/ensure-utf8-console.mjs",
        "seed:groups": "tsx scripts/seed-groups.ts",
        "pretest:jobqueue": "node scripts/ensure-utf8-console.mjs",
        "test:jobqueue": "tsx test/jobQueue.integration.ts",
        "pretest:composer": "node scripts/ensure-utf8-console.mjs",
        "test:composer": "tsx test/composer.manual.ts",
        "prelogin:facebook": "node scripts/ensure-utf8-console.mjs",
        "login:facebook": "tsx scripts/login-facebook.ts",
        "pretest:fbpost": "node scripts/ensure-utf8-console.mjs",
        "test:fbpost": "tsx scripts/test-fb-post.ts",
        "pretest:facebook": "node scripts/ensure-utf8-console.mjs",
        "test:facebook": "tsx test/facebook.smoke.ts",
        "pretelegram:chatid": "node scripts/ensure-utf8-console.mjs",
        "telegram:chatid": "tsx scripts/telegram-chatid.ts",
        "pretest:telegram": "node scripts/ensure-utf8-console.mjs",
        "test:telegram": "tsx test/telegram.manual.ts"
    },
    "dependencies": {
        "@google/genai": "^2.17.1",
        "@types/node-cron": "^3.0.11",
        "dotenv": "^16.4.7",
        "mongodb": "^6.12.0",
        "node-cron": "^4.6.0",
        "node-telegram-bot-api": "^2.0.0",
        "pino": "^9.6.0",
        "pino-roll": "^4.0.0",
        "playwright": "^1.62.1",
        "sharp": "^0.35.3",
        "zca-js": "^2.1.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^4.1.11"
    }
}
